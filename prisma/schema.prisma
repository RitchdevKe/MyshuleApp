  id           String   @id @default(uuid())
  tenantId     String
  jobOpeningId String
  firstName    String
  lastName     String
  email        String
  phone        String?
  status       String   @default("Applied") // Applied, Reviewing, Interviewing, Offered, Hired, Rejected
  resumeUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobOpening JobOpening  @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  interviews Interview[]
}

model Interview {
  id            String   @id @default(uuid())
  tenantId      String
  applicantId   String
  staffId       String
  scheduledDate DateTime
  status        String   @default("Scheduled") // Scheduled, Completed, Canceled, Passed, Rejected
  feedback      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Onboarding {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  role       String
  department String
  startDate  DateTime
  progress   Int      @default(0)
  steps      Json // Array of step objects
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Appraisal {
  id         String   @id @default(uuid())
  tenantId   String
  staffId    String
  reviewerId String
  type       String // Annual, Quarterly, Mid-Year
  status     String   @default("Pending") // Pending, In Progress, Completed
  score      Float?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff    Staff  @relation("StaffAppraisals", fields: [staffId], references: [id], onDelete: Cascade)
  reviewer Staff  @relation("ReviewerAppraisals", fields: [reviewerId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String   @id @default(uuid())
  tenantId    String
  staffId     String
  title       String
  description String?
  status      String   @default("On Track") // On Track, At Risk, Off Track, Completed
  progress    Int      @default(0) // 0 - 100
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Feedback {
  id          String   @id @default(uuid())
  tenantId    String
  senderId    String
  recipientId String
  category    String // Performance, Teamwork, Leadership, General
  content     String
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender    Staff  @relation("SenderFeedback", fields: [senderId], references: [id], onDelete: Cascade)
  recipient Staff  @relation("RecipientFeedback", fields: [recipientId], references: [id], onDelete: Cascade)
}

model TrainingProgram {
  id           String   @id @default(uuid())
  tenantId     String
  title        String
  description  String?
  instructorId String?
  startDate    DateTime
  endDate      DateTime
  status       String   @default("Active") // Active, Completed, Draft
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instructor Staff? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
}

model TrainingRequest {
  id          String   @id @default(uuid())
  tenantId    String
  staffId     String
  courseTitle String
  provider    String?
  cost        Float    @default(0)
  status      String   @default("Pending") // Pending, Approved, Rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Certification {
  id         String    @id @default(uuid())
  tenantId   String
  staffId    String
