  tenantId    String
  name        String
  description String?
  status      String   @default("Active")
  scope       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuthorizationRule {
  id        String   @id @default(uuid())
  tenantId  String
  action    String
  trigger   String
  approver  String
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

