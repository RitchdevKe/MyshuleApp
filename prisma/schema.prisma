}

model FinanceSettings {
  id                      String   @id @default(uuid())
  tenantId                String   @unique
  invoicePrefix           String   @default("INV-")
  receiptPrefix           String   @default("REC-")
  allowPartialPayments    Boolean  @default(true)
  requireDiscountApproval Boolean  @default(false)
  taxRate                 Float    @default(0)
  defaultCurrency         String   @default("KES")
  updatedAt               DateTime @updatedAt
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AttendanceRegister {
  id             String             @id @default(uuid())
  tenantId       String
  academicTermId String
  streamId       String
  date           DateTime
  recordedById   String
  records        AttendanceRecord[]
  academicTerm   AcademicTerm       @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  recordedBy     Staff              @relation(fields: [recordedById], references: [id], onDelete: Cascade)
  stream         Stream             @relation(fields: [streamId], references: [id], onDelete: Cascade)
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([streamId, date])
}

model AttendanceRecord {
  id         String             @id @default(uuid())
  registerId String
  studentId  String
  status     AttendanceStatus
  remarks    String?
  register   AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([registerId, studentId])
}

model DisciplinaryIncident {
  id           String         @id @default(uuid())
  tenantId     String
  studentId    String
  reportedById String
  incidentDate DateTime
  severity     SeverityLevel
  description  String
  actionTaken  String?
  status       IncidentStatus @default(OPEN)
  reportedBy   Staff          @relation(fields: [reportedById], references: [id], onDelete: Cascade)
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ExtracurricularActivity {
  id           String                      @id @default(uuid())
  tenantId     String
  name         String
  activityType ActivityType
  patronId     String?
  patron       Staff?                      @relation(fields: [patronId], references: [id])
  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships  ExtracurricularMembership[]
}

model ExtracurricularMembership {
  id         String                  @id @default(uuid())
  activityId String
  studentId  String
  role       String                  @default("MEMBER")
  joinedDate DateTime                @default(now())
  activity   ExtracurricularActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student    Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([activityId, studentId])
}

model TransportRoute {
  id           String                @id @default(uuid())
  tenantId     String
  routeName    String
  driverId     String?
  vehiclePlate String?
  costPerTerm  Float?
  assignments  TransportAssignment[]
  driver       Staff?                @relation(fields: [driverId], references: [id])
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trips        Trip[]
}

model TransportAssignment {
  id          String         @id @default(uuid())
  routeId     String
  studentId   String
  pickupPoint String
  tripType    TripType
  route       TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([routeId, studentId])
}

model Announcement {
  id             String         @id @default(uuid())
  tenantId       String
  title          String
  content        String
  createdById    String
  targetAudience TargetAudience
  targetClassId  String?
  publishDate    DateTime       @default(now())
  expiryDate     DateTime?
  createdBy      User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  targetClass    Class?         @relation(fields: [targetClassId], references: [id], onDelete: Cascade)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Conversation {
  id               String    @id @default(uuid())
  tenantId         String
  participantOneId String
  participantTwoId String
  createdAt        DateTime  @default(now())
  lastMessageAt    DateTime  @default(now())
  participantOne   User      @relation("ParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo   User      @relation("ParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@unique([participantOneId, participantTwoId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model CommunicationLog {
  id              String               @id @default(uuid())
  tenantId        String
  recipientUserId String?
  channel         CommunicationChannel
  contactAddress  String
  subject         String?
  body            String
  status          CommunicationStatus  @default(SENT)
  providerError   String?
  sentAt          DateTime             @default(now())
  recipientUser   User?                @relation(fields: [recipientUserId], references: [id])
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model UserGroup {
  id          String            @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     UserGroupMember[]
}

model UserGroupMember {
  id        String    @id @default(uuid())
  groupId   String
  userId    String
  createdAt DateTime  @default(now())
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model UserInvitation {
  id        String           @id @default(uuid())
  tenantId  String
  email     String
  roleId    String
  status    InvitationStatus @default(PENDING)
  sentAt    DateTime         @default(now())
  expiresAt DateTime
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AccessRequest {
  id         String          @id @default(uuid())
  tenantId   String
  userId     String
  request    String
  reason     String?
  status     RequestStatus   @default(PENDING)
  priority   RequestPriority @default(MEDIUM)
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

