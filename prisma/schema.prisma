generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  aiAuditLogs         AIAuditLog[]
  aiKnowledge         AIKnowledgeBase[]
  engagementCampaigns EngagementCampaign[]
  engagementEvents    EngagementEvent[]
  engagementSurveys   EngagementSurvey[]
  cateringMenus       CateringMenu[]
  kitchenTasks        KitchenTask[]
  foodInventories     FoodInventory[]
  mealAttendances     MealAttendance[]

  clinicInventories ClinicInventory[]
  medicalRecords    MedicalRecord[]
  clinicVisits      ClinicVisit[]
  emergencyContacts EmergencyContact[]
  welfareSessions   WelfareSession[]

  hostels             Hostel[]
  hostelRooms         HostelRoom[]
  hostelAllocations   HostelAllocation[]
  boardingAttendances BoardingAttendance[]

  libraryBooks       LibraryBook[]
  libraryMembers     LibraryMember[]
  libraryCirculation LibraryCirculation[]
  digitalResources   DigitalResource[]

  vehicles    Vehicle[]
  trips       Trip[]
  fuelRecords FuelRecord[]

  facilities         Facility[]
  assets             Asset[]
  maintenanceRecords MaintenanceRecord[]
  workOrders         WorkOrder[]
  inspections        Inspection[]

  stores            Store[]
  inventoryItems    InventoryItem[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  stockIssues       StockIssue[]

  suppliers        Supplier[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  grns             GoodsReceivedNote[]

  id                    String                    @id @default(uuid())
  name                  String
  domainPrefix          String                    @unique
  logoUrl               String?
  loginBackgroundUrl    String?
  loginDisplayName      String?
  showSchoolNameOnLogin Boolean                   @default(true)
  status                TenantStatus              @default(ACTIVE)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  address               String?
  contactEmail          String?
  contactPhone          String?
  dateFormat            String                    @default("DD/MM/YYYY")
  motto                 String?
  timezone              String                    @default("Africa/Nairobi")
  website               String?
  primaryColor          String?                   @default("#0ea5e9")
  secondaryColor        String?                   @default("#1e293b")
  subscriptionPlan      String                    @default("Free")
  aiSystemState         AiSystemState?
  academicSettings      AcademicSettings?
  academicTerms         AcademicTerm[]
  academicYears         AcademicYear[]
  admissionApplications AdmissionApplication[]
  studentDocuments      StudentDocument[]
  chartOfAccounts       ChartOfAccount[]
  financialYears        FinancialYear[]
  journalEntries        JournalEntry[]
  accessRequests        AccessRequest[]
  announcements         Announcement[]
  attendanceRegisters   AttendanceRegister[]
  auditLogs             AuditLog[]
  bankAccounts          BankAccount[]
  branches              Branch[]
  classes               Class[]
  communicationLogs     CommunicationLog[]
  communicationSettings CommunicationSettings?
  communicationTriggers CommunicationTrigger[]
  conversations         Conversation[]
  disciplinaryIncidents DisciplinaryIncident[]
  disciplinaryActions   DisciplinaryAction[]
  documentTemplates     DocumentTemplate[]
  exams                 Exam[]
  examResults           ExamResult[]
  extracurriculars      ExtracurricularActivity[]
  feeStructures         FeeStructure[]
  financeSettings       FinanceSettings?
  gradingScales         GradingScale[]
  hardwareDevices       HardwareDevice[]
  invoices              Invoice[]
  messageTemplates      MessageTemplate[]
  parents               Parent[]
  payments              Payment[]
  paymentGateways       PaymentGateway[]
  reportCards           ReportCard[]
  roles                 Role[]
  staff                 Staff[]
  streams               Stream[]
  students              Student[]
  enrollments           StudentEnrollment[]
  studentParents        StudentParent[]
  subjects              Subject[]
  allocations           SubjectAllocation[]
  subscriptions         TenantSubscription[]
  tenantUsers           TenantUser[]
  transportRoutes       TransportRoute[]
  userGroups            UserGroup[]
  userInvitations       UserInvitation[]
  pettyCashAccounts     PettyCashAccount[]
  budgets               Budget[]
  budgetApprovals       BudgetApproval[]
  customReports         CustomReport[]
  leadershipPositions   LeadershipPosition[]
  elections             Election[]
  salaryStructures      SalaryStructure[]
  payrollRuns           PayrollRun[]
  deductions            Deduction[]
  payslips              Payslip[]
  jobOpenings           JobOpening[]
  applicants            Applicant[]
  interviews            Interview[]
  onboardings           Onboarding[]
  appraisals            Appraisal[]
  goals                 Goal[]
  feedbacks             Feedback[]
  trainingPrograms      TrainingProgram[]
  trainingRequests      TrainingRequest[]
  certifications        Certification[]
  benefits              Benefit[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  timesheets            Timesheet[]
  grievances            Grievance[]
  refunds               Refund[]
  aiDailyBriefs         AiDailyBrief[]
  aiFaqCaches           AiFaqCache[]
}

model SystemModule {
  id            String               @id @default(uuid())
  name          String
  isMandatory   Boolean              @default(false)
  description   String?
  permissions   Permission[]
  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id         String       @id @default(uuid())
  tenantId   String
  moduleId   String
  status     ModuleStatus @default(ACTIVE)
  validUntil DateTime?
  module     SystemModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
}

model Branch {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  levelTypes  LevelType[]
  address     String?
  head        String?
  capacity    Int?
  status      String       @default("Active")
  founded     String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes     Class[]
  tenantUsers TenantUser[]
}

model AcademicYear {
  id            String              @id @default(uuid())
  tenantId      String
  name          String
  startDate     DateTime
  endDate       DateTime
  isActiveYear  Boolean             @default(false)
  terms         AcademicTerm[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  enrollments   StudentEnrollment[]
  allocations   SubjectAllocation[]
}

model AcademicTerm {
  id                  String               @id @default(uuid())
  tenantId            String
  academicYearId      String
  name                String
  startDate           DateTime
  endDate             DateTime
  isActiveTerm        Boolean              @default(false)
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRegisters AttendanceRegister[]
  exams               Exam[]
  invoices            Invoice[]
}

model User {
  aiAuditLogs                   AIAuditLog[]
  id                            String             @id @default(uuid())
  email                         String             @unique
  passwordHash                  String
  phoneNumber                   String?            @unique
  isVerified                    Boolean            @default(false)
  status                        UserStatus         @default(ACTIVE)
  lastLoginAt                   DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  accessRequests                AccessRequest[]
  announcementsCreated          Announcement[]
  auditLogs                     AuditLog[]
  communicationLogsReceived     CommunicationLog[]
  conversationsAsParticipantOne Conversation[]     @relation("ParticipantOne")
  conversationsAsParticipantTwo Conversation[]     @relation("ParticipantTwo")
  messagesSent                  Message[]
  parents                       Parent[]
  payments                      Payment[]
  staff                         Staff[]
  students                      Student[]
  tenantUsers                   TenantUser[]
  groupMemberships              UserGroupMember[]
  refunds                       Refund[]
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String?
  name        String
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  tenantUsers TenantUser[]
  invitations UserInvitation[]
}

model Permission {
  id         String           @id @default(uuid())
  moduleId   String
  actionName String
  module     SystemModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  roles      RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model TenantUser {
  id       String  @id @default(uuid())
  userId   String
  tenantId String
  roleId   String
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String
  entityName String
  ipAddress  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Student {
  id                         String                      @id @default(uuid())
  tenantId                   String
  userId                     String?
  admissionNumber            String
  firstName                  String
  lastName                   String
  dateOfBirth                DateTime
  gender                     Gender
  medicalConditions          String?
  status                     StudentStatus               @default(ACTIVE)
  enrollmentDate             DateTime
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  attendanceRecords          AttendanceRecord[]
  disciplinaryIncidents      DisciplinaryIncident[]
  examResults                ExamResult[]
  extracurricularMemberships ExtracurricularMembership[]
  leadershipPositions        LeadershipPosition[]
  invoices                   Invoice[]
  reportCards                ReportCard[]
  documents                  StudentDocument[]
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                       User?                       @relation(fields: [userId], references: [id])
  enrollments                StudentEnrollment[]
  parents                    StudentParent[]
  transportAssignments       TransportAssignment[]
  libraryMember              LibraryMember?
  hostelAllocation           HostelAllocation?
  boardingAttendances        BoardingAttendance[]
  medicalRecord              MedicalRecord?
  clinicVisits               ClinicVisit[]
  emergencyContacts          EmergencyContact[]
  welfareSessions            WelfareSession[]
  mealAttendances            MealAttendance[]
  payments                   Payment[]

  @@unique([tenantId, admissionNumber])
}

model Parent {
  id                 String          @id @default(uuid())
  tenantId           String
  userId             String
  firstName          String
  lastName           String
  nationalIdNumber   String?
  phonePrimary       String
  phoneSecondary     String?
  residentialAddress String?
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students           StudentParent[]
}

model StudentParent {
  id                  String             @id @default(uuid())
  tenantId            String
  studentId           String
  parentId            String
  relationship        ParentRelationship
  isEmergencyContact  Boolean            @default(false)
  isFinancialSponsor  Boolean            @default(false)
  canPickupFromSchool Boolean            @default(false)
  parent              Parent             @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}

model Staff {
  id                    String                    @id @default(uuid())
  tenantId              String
  userId                String
  employeeNumber        String
  firstName             String
  lastName              String
  jobTitle              String
  department            Department
  gender                String?
  dateOfBirth           DateTime?
  hireDate              DateTime
  endDate               DateTime?
  status                StaffStatus               @default(ACTIVE)
  attendanceRegisters   AttendanceRegister[]
  disciplinaryIncidents DisciplinaryIncident[]
  disciplinaryActions   DisciplinaryAction[]
  extracurriculars      ExtracurricularActivity[]
  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  streams               Stream[]
  allocations           SubjectAllocation[]
  transportRoutes       TransportRoute[]
  salaryStructure       SalaryStructure?          @relation(fields: [salaryStructureId], references: [id])
  salaryStructureId     String?
  payslips              Payslip[]
  interviews            Interview[]
  appraisals            Appraisal[]               @relation("StaffAppraisals")
  conductedAppraisals   Appraisal[]               @relation("ReviewerAppraisals")
  goals                 Goal[]
  sentFeedback          Feedback[]                @relation("SenderFeedback")
  receivedFeedback      Feedback[]                @relation("RecipientFeedback")
  trainingPrograms      TrainingProgram[]
  trainingRequests      TrainingRequest[]
  certifications        Certification[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  timesheets            Timesheet[]
  grievances            Grievance[]
  stores                Store[]
  vehicles              Vehicle[]
  trips                 Trip[]

  @@unique([tenantId, employeeNumber])
}

model Subject {
  id            String              @id @default(uuid())
  tenantId      String
  name          String
  code          String
  isCoreSubject Boolean             @default(true)
  examResults   ExamResult[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations   SubjectAllocation[]

  @@unique([tenantId, code])
}

model Class {
  id            String              @id @default(uuid())
  tenantId      String
  branchId      String
  name          String
  announcements Announcement[]
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  streams       Stream[]
  enrollments   StudentEnrollment[]

  @@unique([tenantId, name])
}

model Stream {
  id                  String               @id @default(uuid())
  tenantId            String
  classId             String
  name                String
  classTeacherId      String?
  capacity            Int
  attendanceRegisters AttendanceRegister[]
  class               Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher        Staff?               @relation(fields: [classTeacherId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments         StudentEnrollment[]
  allocations         SubjectAllocation[]

  @@unique([classId, name])
}

model StudentEnrollment {
  id             String       @id @default(uuid())
  tenantId       String
  academicYearId String
  studentId      String
  classId        String
  streamId       String
  rollNumber     String?
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  stream         Stream       @relation(fields: [streamId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentId])
}

model SubjectAllocation {
  id             String       @id @default(uuid())
  tenantId       String
  academicYearId String
  staffId        String
  subjectId      String
  streamId       String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  stream         Stream       @relation(fields: [streamId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, staffId, subjectId, streamId])
}

model GradingScale {
  id        String              @id @default(uuid())
  tenantId  String
  name      String
  scaleType ScaleType
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ranges    GradingScaleRange[]
}

model GradingScaleRange {
  id             String       @id @default(uuid())
  gradingScaleId String
  gradeLabel     String
  minScore       Float
  maxScore       Float
  defaultRemarks String?
  examResults    ExamResult[]
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)
}

model AcademicSettings {
  id                      String   @id @default(uuid())
  tenantId                String   @unique
  anonymousGrading        Boolean  @default(false)
  strictInvigilation      Boolean  @default(true)
  autoPublishResults      Boolean  @default(false)
  lockGradesAfterPublish  Boolean  @default(true)
  minPassMark             Float    @default(40)
  distinctionMark         Float    @default(80)
  requireDailyAttendance  Boolean  @default(true)
  notifyParentsOnAbsence  Boolean  @default(false)
  absenceWarningThreshold Int      @default(3)
  updatedAt               DateTime @updatedAt
  periodDurationMinutes   Int      @default(40)
  periodsPerDay           Int      @default(8)
  schoolEndTime           String   @default("15:30")
  schoolStartTime         String   @default("08:00")
  breakSlots              Json     @default("[]")
  enableRemedialClasses   Boolean  @default(false)
  remedialAfterSchool     Boolean  @default(false)
  remedialBeforeSchool    Boolean  @default(false)
  remedialEndTime         String   @default("07:30")
  remedialHolidays        Boolean  @default(false)
  remedialStartTime       String   @default("06:30")
  remedialWeekends        Boolean  @default(false)
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id                      String       @id @default(uuid())
  tenantId                String
  name                    String
  type                    DocumentType
  isDefault               Boolean      @default(false)
  showClassTeacherRemarks Boolean      @default(true)
  showPrincipalRemarks    Boolean      @default(true)
  showAttendance          Boolean      @default(true)
  showBehavior            Boolean      @default(true)
  footerText              String?
  tenant                  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CommunicationSettings {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  emailProvider String   @default("SMTP")
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String?
  smsProvider   String   @default("TWILIO")
  smsApiKey     String?
  smsSenderId   String?
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MessageTemplate {
  id        String                 @id @default(uuid())
  tenantId  String
  name      String
  channel   MessageChannel
  subject   String?
  body      String
  isActive  Boolean                @default(true)
  updatedAt DateTime               @updatedAt
  triggers  CommunicationTrigger[]
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CommunicationTrigger {
  id         String           @id @default(uuid())
  tenantId   String
  event      String
  channel    MessageChannel
  isActive   Boolean          @default(true)
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, event, channel])
}

model HardwareDevice {
  id         String         @id @default(uuid())
  tenantId   String
  name       String
  type       HardwareType
  ipAddress  String?
  macAddress String?
  status     HardwareStatus @default(OFFLINE)
  lastPing   DateTime?
  location   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Exam {
  id             String       @id @default(uuid())
  tenantId       String
  academicTermId String
  name           String
  startDate      DateTime
  endDate        DateTime
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examResults    ExamResult[]
  reportCards    ReportCard[]
}

model ExamResult {
  id             String             @id @default(uuid())
  tenantId       String
  examId         String
  studentId      String
  subjectId      String
  numericScore   Float?
  rubricScore    Int?
  gradeId        String?
  teacherRemarks String?
  exam           Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  gradeRange     GradingScaleRange? @relation(fields: [gradeId], references: [id])
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId])
}

model ReportCard {
  id                  String  @id @default(uuid())
  tenantId            String
  examId              String
  studentId           String
  totalScore          Float?
  averageScore        Float?
  overallGrade        String?
  classTeacherRemarks String?
  principalRemarks    String?
  isPublished         Boolean @default(false)
  exam                Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model FeeStructure {
  id             String       @id @default(uuid())
  tenantId       String
  academicYearId String
  classId        String
  name           String
  totalAmount    Float
  items          FeeItem[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, classId, name])
}

model FeeItem {
  id             String       @id @default(uuid())
  feeStructureId String
  name           String
  amount         Float
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  academicTermId String
  studentId      String
  invoiceNumber  String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subTotal       Float
  discount       Float         @default(0)
  totalAmount    Float
  amountPaid     Float         @default(0)
  balanceDue     Float
  status         InvoiceStatus @default(UNPAID)
  notes          String?
  academicTerm   AcademicTerm  @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items          InvoiceItem[]
  payments       Payment[]

  @@unique([tenantId, invoiceNumber])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  ALLOCATED
  UNALLOCATED
  REFUNDED
  REVERSED
  FAILED
}

model Payment {
  id              String        @id @default(uuid())
  tenantId        String
  invoiceId       String?
  studentId       String?
  recordedById    String
  receiptNumber   String
  amount          Float
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod
  status          PaymentStatus @default(ALLOCATED)
  referenceNumber String?
  notes           String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  student         Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  recordedBy      User          @relation(fields: [recordedById], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refunds         Refund[]

  @@unique([tenantId, receiptNumber])
}

model Refund {
  id           String   @id @default(uuid())
  tenantId     String
  paymentId    String
  amount       Float
  reason       String?
  refundDate   DateTime @default(now())
  recordedById String

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id])
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BankAccount {
  id              String               @id @default(uuid())
  tenantId        String
  bankName        String
  accountName     String
  accountNumber   String
  branchName      String?
  swiftCode       String?
  currency        String               @default("KES")
  isActive        Boolean              @default(true)
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
